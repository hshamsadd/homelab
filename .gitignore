# Secrets
.env
.env.*
*.key
*.pem
*.crt
*.p12
*.kubeconfig
kubeconfig

# Block everything inside secrets directories by default
**/secrets/*
# Exceptions: Allow kustomization and sealed variants
!**/secrets/kustomization.yaml
!**/secrets/*-sealed.yaml

# Terraform
.terraform/
*.tfstate
*.tfstate.*
.terraform.lock.hcl

# Ansible
*.retry
.vault_pass
vault-password.txt

# Kubernetes generated files
*.tmp
*.bak
*.swp

# Editor/OS
.vscode/
.idea/
.DS_Store

# Logs
*.log
logs/